{
  "name": "whatsmyagentdoing",
  "version": "0.3.1",
  "description": "See what every Claude Code and Codex agent on your machine is doing, live in your browser.",
  "bin": {
    "whatsmyagentdoing": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "assets",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "agents",
    "dashboard",
    "monitor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charonyuu/whatsmyagentdoing.git"
  },
  "homepage": "https://github.com/Charonyuu/whatsmyagentdoing#readme",
  "bugs": {
    "url": "https://github.com/Charonyuu/whatsmyagentdoing/issues"
  },
  "author": "cheoyu",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "three": "^0.186.1"
  },
  "scripts": {
    "test": "node --test tests/watcher.cjs tests/herdr.cjs tests/cli-session.cjs tests/teams.cjs tests/office-team.cjs tests/homepage.cjs tests/local-safety.cjs tests/cloud.cjs tests/rules.cjs",
    "test:town": "node tests/homepage-ui.cjs && node tests/town.cjs",
    "test:wide": "node tests/wide-ui.cjs",
    "test:compact": "node tests/compact-ui.cjs",
    "test:rules-ui": "node tests/rules-ui.cjs && node tests/rules-integration.cjs",
    "capture:homepage": "node scripts/capture-homepage.cjs",
    "build": "esbuild web/office3d.js --bundle --format=esm --minify --target=es2020 --outfile=public/office3d.js --legal-comments=eof",
    "start": "node bin/cli.js",
    "test:ui": "node tests/ui.cjs",
    "test:watcher": "node --test tests/watcher.cjs",
    "cf:build": "node cloudflare/build.mjs"
  }
}
